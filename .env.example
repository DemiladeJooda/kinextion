# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/kinextion?sslmode=require"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# apps/api (@clerk/fastify) reads the unprefixed name — same value as above.
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."

# Anthropic AI
ANTHROPIC_API_KEY="sk-ant-..."

# Upstash Redis (for BullMQ)
REDIS_URL="redis://..."

# Cloudflare R2 Storage — community recordings.
# Uploaded and played back with presigned URLs; the API never carries the bytes.
# Leave blank and the upload routes answer 503 while everything else runs, but
# nothing gets purged either — set these before real users record anything.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="kinextion"

# Community dev tools (apps/api) — a movable clock at /api/community/dev/clock
# so a whole week can be walked in a minute. Never enabled in production.
COMMUNITY_DEV_TOOLS="0"

# API
API_PORT=3001
API_HOST="0.0.0.0"
# Publicly reachable base URL for apps/api — providers redirect here after OAuth.
# Required in production.
API_PUBLIC_URL="http://localhost:3001"
# Comma-separated origins allowed to call the API. Required in production;
# in development every origin is allowed so simulators and devices just work.
WEB_ORIGIN="https://kinextion.com"

# Web
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Integrations (apps/api) — Strava/Whoop/Oura wearable connections.
# Symmetric key used to encrypt stored OAuth tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATIONS_ENCRYPTION_KEY=""
# Deep link the OAuth callback hands off to once tokens are stored.
MOBILE_DEEP_LINK_URL="kinextion://integrations/callback"
# Each provider is optional — until its client id/secret are set, /connect
# returns a clear "not configured yet" error instead of pretending to work.
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
WHOOP_CLIENT_ID=""
WHOOP_CLIENT_SECRET=""
OURA_CLIENT_ID=""
OURA_CLIENT_SECRET=""
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Calendar connections (apps/api) — used only to derive the *shape* of a day
# (first commitment, minutes booked, longest free block) so habit cues land in
# real gaps. Event titles, attendees and locations are discarded at the
# adapter boundary and never stored. See providers/calendar-rhythm.ts.
#
# Google Cloud console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI: {API_PUBLIC_URL}/api/integrations/google_calendar/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Azure portal → App registrations → Certificates & secrets.
# Redirect URI: {API_PUBLIC_URL}/api/integrations/outlook_calendar/callback
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# "common" accepts personal and work accounts; set a tenant id to restrict it.
MICROSOFT_TENANT_ID="common"
