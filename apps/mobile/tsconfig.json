{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],

      // The web app runs React 19 (required by Next 15) while Expo 52 / RN
      // 0.76 pins React 18, so pnpm keeps both @types/react majors in the
      // store and transitive packages can resolve the wrong one. That surfaces
      // as "X cannot be used as a JSX component … 'bigint' is not assignable
      // to ReactNode".
      //
      // Forcing every `react` type resolution to this app's own copy stops the
      // two majors mixing. Remove once Expo supports React 19.
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
